<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.url">jdbc:h2:mem:videogames_test;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1</property>
        <property name="hibernate.connection.username">sa</property>
        <property name="hibernate.connection.password"></property>
        <property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>
        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">false</property>
        <property name="hibernate.hbm2ddl.auto">create-drop</property>

        <mapping class="com.videogames.library.model.Utilisateur"/>
        <mapping class="com.videogames.library.model.RelationUtilisateur"/>
        <mapping class="com.videogames.library.model.Genre"/>
        <mapping class="com.videogames.library.model.Plateforme"/>
        <mapping class="com.videogames.library.model.Jeu"/>
        <mapping class="com.videogames.library.model.EntreeBibliotheque"/>
    </session-factory>
</hibernate-configuration>
