<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/13"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.videogames.library.controller.TirageController"
    spacing="12">

    <fx:define>
        <ToggleGroup fx:id="modeGroupe" />
    </fx:define>

    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="Tirage aléatoire" />
        <RadioButton fx:id="multiRadio" text="Multijoueur (groupe d'amis)" toggleGroup="$modeGroupe"
            selected="true" />
        <RadioButton fx:id="soloRadio" text="Solo" toggleGroup="$modeGroupe" />
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Groupe (multi)" />
            <Button text="Rafraîchir les amis" onAction="#surRafraichir" />
            <ListView fx:id="amisList" VBox.vgrow="ALWAYS" prefHeight="220" />
        </VBox>

        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Filtres" />
            <ComboBox fx:id="genreCombo" promptText="Genre" maxWidth="Infinity" />
            <ComboBox fx:id="plateformeCombo" promptText="Plateforme" maxWidth="Infinity" />
            <TextField fx:id="prixMaxField" promptText="Prix maximum (€)" />
            <Region VBox.vgrow="ALWAYS" />
        </VBox>

        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Jeux exclus" />
            <ListView fx:id="exclusionsList" VBox.vgrow="ALWAYS" prefHeight="220" />
            <HBox spacing="8">
                <Button text="Exclure…" onAction="#surAjouterExclusion" />
                <Button text="Ne plus exclure" onAction="#surRetirerExclusion" />
            </HBox>
        </VBox>

        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Jeux ajoutés" />
            <ListView fx:id="ajoutsList" VBox.vgrow="ALWAYS" prefHeight="220" />
            <HBox spacing="8">
                <Button text="Ajouter…" onAction="#surAjouterAjout" />
                <Button text="Retirer" onAction="#surRetirerAjout" />
            </HBox>
        </VBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Button text="Lancer le tirage" onAction="#surTirer" />
        <Label fx:id="message" />
    </HBox>

    <VBox spacing="4">
        <Label fx:id="resultatTitre" text="—" />
        <Label fx:id="resultatDetails" wrapText="true" />
    </VBox>
</VBox>
