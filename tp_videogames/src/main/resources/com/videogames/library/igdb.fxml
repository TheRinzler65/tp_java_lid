<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/13"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.videogames.library.controller.IgdbController"
    spacing="12">

    <Label text="Recherche IGDB" />

    <HBox alignment="CENTER_LEFT" spacing="8">
        <TextField fx:id="queryField" promptText="Titre du jeu à rechercher sur IGDB"
            HBox.hgrow="ALWAYS" onAction="#surRechercher" />
        <Button fx:id="rechercheButton" text="Rechercher sur IGDB" onAction="#surRechercher" />
    </HBox>

    <Label fx:id="message" wrapText="true" />

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTitre" text="Titre" prefWidth="220" />
            <TableColumn fx:id="colDate" text="Sortie" prefWidth="90" />
            <TableColumn fx:id="colMode" text="Mode" prefWidth="110" />
            <TableColumn fx:id="colGenres" text="Genres" prefWidth="190" />
            <TableColumn fx:id="colPlateformes" text="Plateformes" prefWidth="220" />
        </columns>
    </TableView>

    <HBox spacing="8">
        <Button text="Importer et ajouter à ma bibliothèque" onAction="#surImporter" />
    </HBox>
</VBox>
