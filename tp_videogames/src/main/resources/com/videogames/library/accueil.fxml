<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/13"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.videogames.library.controller.AccueilController"
    prefWidth="1180" prefHeight="760" styleClass="root">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="header">
            <Label text="GameLib" styleClass="brand" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="pseudoLabel" styleClass="pseudo" />
            <Button text="Se déconnecter" onAction="#seDeconnecter" />
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="main-tabs">
            <Tab text="Bibliothèque">
                <fx:include source="bibliotheque.fxml" />
            </Tab>
            <Tab text="Amis">
                <fx:include source="amis.fxml" />
            </Tab>
            <Tab text="Recherche">
                <fx:include source="recherche.fxml" />
            </Tab>
            <Tab text="Comparer">
                <fx:include source="comparaison.fxml" />
            </Tab>
            <Tab text="Tirage">
                <fx:include source="tirage.fxml" />
            </Tab>
        </TabPane>
    </center>
</BorderPane>
